# ====================================================================
# RAVITECH ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to configure your private credentials
# ====================================================================

# 1. Supabase Database & Auth (Optional / Production)
# Obtain from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Private Administrator Credentials
# Configure your private administrator email and password here.
# These credentials are used for the secure /admin/login portal.
NEXT_PUBLIC_ADMIN_EMAIL=admin@ravitech.edu
NEXT_PUBLIC_ADMIN_PASSWORD=Admin@RaviTech2026
